{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ad",
      "destination": "/genuss_black_friday_platform_ad.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
